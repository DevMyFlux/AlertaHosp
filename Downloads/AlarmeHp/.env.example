# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Vonage credentials for WhatsApp/SMS notifications (/api/notify).
# VONAGE_APPLICATION_ID and VONAGE_PRIVATE_KEY can alternatively be
# configured per-user in the app's Settings screen (stored in the browser).
VONAGE_API_KEY="MY_VONAGE_API_KEY"
VONAGE_API_SECRET="MY_VONAGE_API_SECRET"
VONAGE_APPLICATION_ID="MY_VONAGE_APPLICATION_ID"
VONAGE_PRIVATE_KEY="MY_VONAGE_PRIVATE_KEY"

# WhatsApp Message Template used for business-initiated alerts (required by
# Meta outside an active 24h customer session; free-form text gets silently
# rejected). Vonage references templates as "namespace:template_name".
# Defaults below match the "sistema_de_alerta" template already approved for
# this WABA (params: hora, setor, message) — override only if using a
# different template.
VONAGE_WHATSAPP_TEMPLATE_NAMESPACE="678e6487_99c4_4e6d_995c_3dab76a2438b"
VONAGE_WHATSAPP_TEMPLATE_NAME="sistema_de_alerta"
VONAGE_WHATSAPP_TEMPLATE_LOCALE="pt_BR"

# --- /api/cron-check: checagem de anomalia + alerta rodando no servidor,
# independente de qualquer navegador estar aberto (ver api/app.ts) ---
#
# O disparo periódico (a cada 15 min) e o armazenamento de estado (quais
# setores já estão em alerta, histórico de 30 dias) rodam num Apps Script
# preso à própria planilha de telemetria — ver apps-script/README.md pro
# passo a passo completo (colar o script, implantar como Web App, configurar
# o gatilho de tempo). Não precisa de Google Cloud Console, Service Account
# nem de um pinger externo.

# Segredo compartilhado — TEM QUE SER O MESMO valor usado como
# SHARED_SECRET dentro de apps-script/Code.gs. Usado nos dois sentidos:
# o Apps Script manda esse valor no header "Authorization: Bearer <segredo>"
# ao chamar /api/cron-check, e o backend manda esse valor pro Apps Script
# ao ler/escrever a aba EstadoAlertas.
CRON_SECRET="MY_RANDOM_CRON_SECRET"

# URL do Web App do Apps Script (termina em /exec) — copiada na tela de
# implantação, ver apps-script/README.md passo 3.
SHEETS_WEBAPP_URL="https://script.google.com/macros/s/MY_DEPLOYMENT_ID/exec"

# Números (formato internacional, sem "+", separados por vírgula pra vários)
# que recebem os alertas automáticos do cron. Sem isso, cai no número padrão
# hardcoded em api/lib/notify.ts.
ALERT_PHONE_NUMBERS="5511949102183"

# Remetente do WhatsApp usado pelo cron — mesma lógica de ALERT_PHONE_NUMBERS.
ALERT_WHATSAPP_FROM="556298792013"

# Margem de alerta (%) usada pelo cron — equivalente ao campo "Margem de
# Alerta" da tela de Configurações (que só afeta o navegador de quem
# configurou). Padrão: 20.
ALERT_MARGIN_PCT="20"

# Tarifa de energia (R$/kWh) usada pelo cron nos cálculos de custo estimado
# — equivalente ao campo "Tarifa" da tela de Configurações. Padrão: 0.75.
TARIFF_BRL_PER_KWH="0.75"
