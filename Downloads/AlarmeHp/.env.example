# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Vonage credentials for WhatsApp/SMS notifications (/api/notify).
# VONAGE_APPLICATION_ID and VONAGE_PRIVATE_KEY can alternatively be
# configured per-user in the app's Settings screen (stored in the browser).
VONAGE_API_KEY="MY_VONAGE_API_KEY"
VONAGE_API_SECRET="MY_VONAGE_API_SECRET"
VONAGE_APPLICATION_ID="MY_VONAGE_APPLICATION_ID"
VONAGE_PRIVATE_KEY="MY_VONAGE_PRIVATE_KEY"

# Name of the WhatsApp Message Template approved in Meta Business Manager,
# required for business-initiated WhatsApp alerts (outside a 24h customer
# session). The template must accept 2 parameters: sector and message.
# When unset, /api/notify falls back to free-form text, which WhatsApp only
# delivers within an active 24h conversation window.
VONAGE_WHATSAPP_TEMPLATE_NAME=""
VONAGE_WHATSAPP_TEMPLATE_LOCALE="pt_BR"
