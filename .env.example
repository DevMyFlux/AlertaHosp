# ─────────────────────────────────────────────────────────────────────────────
# Variáveis de ambiente (Vercel → Settings → Environment Variables; local → .env.local).
# NUNCA commitar valores reais. Backend e frontend NÃO compartilham nada daqui:
# o navegador só fala com /api; nenhuma variável é exposta ao cliente.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# Obrigatória em produção. Formato: postgres://usuario:senha@host:5432/banco
# Use um usuário com permissão só neste banco (não o administrador).
DATABASE_URL=
# default | require | no-verify (certificado autoassinado) | disable
DATABASE_SSL=

# ── Acesso ao painel ────────────────────────────────────────────────────────
# Senha da equipe. Se definida, o painel exige login; ações que custam dinheiro
# (mensagem de teste) SÓ funcionam com ela definida e com sessão aberta.
APP_ACCESS_PASSWORD=
# Chave que assina o cookie de sessão (qualquer texto longo e aleatório). Opcional:
# sem ela, deriva da própria senha.
SESSION_SECRET=

# ── Ciclo agendado (Apps Script → /api/cron-check) ──────────────────────────
# Segredo enviado em "Authorization: Bearer …". HCN sem sufixo, HMB com _HMB.
# Gere um por hospital:  openssl rand -hex 32
CRON_SECRET=
CRON_SECRET_HMB=

# ── Ingestão direta (opcional): POST /api/ingest/<UNIDADE> ──────────────────
INGEST_KEY=
INGEST_KEY_HMB=

# ── WhatsApp / SMS (Vonage) ─────────────────────────────────────────────────
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY=
# Opcional: chave de assinatura dos webhooks de status (valida o retorno da Vonage)
VONAGE_SIGNATURE_SECRET=

# Por hospital (HCN sem sufixo, HMB com _HMB). Telefones: DDI+DDD+número, sem "+",
# separados por vírgula.
ALERT_PHONE_NUMBERS=
ALERT_PHONE_NUMBERS_HMB=
# Número remetente do WhatsApp e namespace da WABA onde o template está aprovado
ALERT_WHATSAPP_FROM=
ALERT_WHATSAPP_FROM_HMB=
VONAGE_WHATSAPP_TEMPLATE_NAMESPACE=
VONAGE_WHATSAPP_TEMPLATE_NAMESPACE_HMB=

# ── Modo sombra ─────────────────────────────────────────────────────────────
# true = avalia, grava alertas e notificações, mas NÃO envia mensagens. Use ao
# colocar o motor novo em paralelo ao antigo, antes de desligar o antigo.
SHADOW_MODE=
