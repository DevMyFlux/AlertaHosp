# GEMINI_API_KEY: necessária para as chamadas à API do Gemini (chat de IA,
# hoje removido do menu do frontend até essa variável ser confirmada em
# produção — ver comentário em src/App.tsx).
GEMINI_API_KEY=

# Vonage — credenciais pra notificações WhatsApp/SMS (/api/notify).
# VONAGE_APPLICATION_ID e VONAGE_PRIVATE_KEY podem alternativamente ser
# configurados por usuário na tela de Configurações do app (salvos no navegador).
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY=

# Template de mensagem WhatsApp usado nos alertas iniciados pelo negócio
# (exigido pela Meta fora de uma sessão ativa de 24h com o cliente; texto
# livre é rejeitado silenciosamente). A Vonage referencia templates como
# "namespace:nome_do_template".
VONAGE_WHATSAPP_TEMPLATE_NAMESPACE=
VONAGE_WHATSAPP_TEMPLATE_NAME=
VONAGE_WHATSAPP_TEMPLATE_LOCALE=

# --- /api/cron-check: checagem de anomalia + alerta rodando no servidor,
# independente de qualquer navegador estar aberto (ver api/app.ts) ---
#
# O disparo periódico (a cada 15 min) e o armazenamento de estado (quais
# setores já estão em alerta, histórico de alertas) rodam num Apps Script
# preso à própria planilha de telemetria — ver apps-script/README.md pro
# passo a passo completo (colar o script, implantar como Web App, configurar
# o gatilho de tempo). Não precisa de Google Cloud Console, Service Account
# nem de um pinger externo.

# Segredo compartilhado — TEM QUE SER O MESMO valor usado como
# SHARED_SECRET dentro de apps-script/Code.gs. Usado nos dois sentidos:
# o Apps Script manda esse valor no header "Authorization: Bearer <segredo>"
# ao chamar /api/cron-check, e o backend manda esse valor pro Apps Script
# ao ler/escrever a aba EstadoAlertas.
CRON_SECRET=

# URL do Web App do Apps Script (termina em /exec) — copiada na tela de
# implantação, ver apps-script/README.md passo 3.
SHEETS_WEBAPP_URL=

# Números (formato internacional, sem "+", separados por vírgula pra vários)
# que recebem os alertas automáticos do cron. Sem isso, cai no número padrão
# hardcoded em api/lib/notify.ts.
ALERT_PHONE_NUMBERS=

# Remetente do WhatsApp usado pelo cron — mesma lógica de ALERT_PHONE_NUMBERS.
ALERT_WHATSAPP_FROM=

# Margem de alerta (%) usada pelo cron — equivalente ao campo "Margem de
# Alerta" da tela de Configurações (que só afeta o navegador de quem
# configurou). Padrão: 20.
ALERT_MARGIN_PCT=

# Tarifa de energia (R$/kWh) usada pelo cron nos cálculos de custo estimado
# — equivalente ao campo "Tarifa" da tela de Configurações. Padrão: 0.75.
TARIFF_BRL_PER_KWH=
